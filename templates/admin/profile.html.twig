{% extends 'base.html.twig' %}

{% block title %}Administrator Profile - Bartoces Tastes (Symfony 6.4){% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-user-shield"></i> Administrator Profile</h1>
        <p>Manage your executive administrative credentials and account security.</p>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:24px; max-width:1000px;">
    
    <div class="table-card" style="padding:24px;">
        <h2 style="font-family:'Playfair Display',serif; color:var(--gold); font-size:18px; margin-bottom:18px;">
            <i class="fa-solid fa-address-card" style="margin-right:8px;"></i> Account Details
        </h2>
        <form method="POST" action="{{ path('admin_profile') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="update_profile">

            <div style="margin-bottom:14px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Full Name *</label>
                <input type="text" name="name" class="admin-input" style="width:100%;" value="{{ userData.name }}" required>
            </div>

            <div style="margin-bottom:14px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Username (Read-only)</label>
                <input type="text" class="admin-input" style="width:100%; opacity:0.7;" value="{{ userData.username }}" readonly>
            </div>

            <div style="margin-bottom:14px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Email Address *</label>
                <input type="email" name="email" class="admin-input" style="width:100%;" value="{{ userData.email }}" required>
            </div>

            <div style="margin-bottom:18px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Mobile Phone</label>
                <input type="tel" name="phone" class="admin-input" style="width:100%;" value="{{ userData.phone }}">
            </div>

            <div style="margin-bottom:18px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Privilege Level</label>
                <span class="badge" style="background:rgba(201,168,76,0.18); color:var(--gold-light); font-weight:700;">
                    <i class="fa-solid fa-shield-halved"></i> SYSTEM ADMINISTRATOR (Full RBAC)
                </span>
            </div>

            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Save Profile Details
            </button>
        </form>
    </div>

    
    <div class="table-card" style="padding:24px;">
        <h2 style="font-family:'Playfair Display',serif; color:var(--gold); font-size:18px; margin-bottom:18px;">
            <i class="fa-solid fa-lock" style="margin-right:8px;"></i> Change Password
        </h2>
        <form method="POST" action="{{ path('admin_profile') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="change_password">

            <div style="margin-bottom:14px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Current Password *</label>
                <input type="password" name="current_password" class="admin-input" style="width:100%;" required placeholder="Enter current password">
            </div>

            <div style="margin-bottom:14px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">New Password *</label>
                <input type="password" name="new_password" class="admin-input" style="width:100%;" required minlength="6" placeholder="Min 6 characters">
            </div>

            <div style="margin-bottom:20px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Confirm New Password *</label>
                <input type="password" name="confirm_password" class="admin-input" style="width:100%;" required minlength="6" placeholder="Re-type new password">
            </div>

            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-key"></i> Update Password
            </button>
        </form>
    </div>
</div>
{% endblock %}

