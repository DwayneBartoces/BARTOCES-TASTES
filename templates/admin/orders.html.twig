{% extends 'base.html.twig' %}

{% block title %}Orders Management - Bartoces Tastes (Symfony 6.4){% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-bag-shopping"></i> Live Customer Orders</h1>
        <p>Monitor real-time incoming orders, update kitchen preparation status, and review customer bills.</p>
    </div>
</div>

<div class="filter-bar">
    <a href="{{ path('admin_orders', {status: 'all'}) }}" class="filter-tab {% if currentStatus == 'all' %}active{% endif %}">
        All Orders
    </a>
    <a href="{{ path('admin_orders', {status: 'pending'}) }}" class="filter-tab {% if currentStatus == 'pending' %}active{% endif %}">
        <i class="fa-solid fa-clock"></i> Pending
    </a>
    <a href="{{ path('admin_orders', {status: 'confirmed'}) }}" class="filter-tab {% if currentStatus == 'confirmed' %}active{% endif %}">
        <i class="fa-solid fa-check"></i> Confirmed
    </a>
    <a href="{{ path('admin_orders', {status: 'preparing'}) }}" class="filter-tab {% if currentStatus == 'preparing' %}active{% endif %}">
        <i class="fa-solid fa-fire"></i> Preparing
    </a>
    <a href="{{ path('admin_orders', {status: 'ready'}) }}" class="filter-tab {% if currentStatus == 'ready' %}active{% endif %}">
        <i class="fa-solid fa-bell"></i> Ready
    </a>
    <a href="{{ path('admin_orders', {status: 'completed'}) }}" class="filter-tab {% if currentStatus == 'completed' %}active{% endif %}">
        <i class="fa-solid fa-circle-check"></i> Completed
    </a>
    <a href="{{ path('admin_orders', {status: 'cancelled'}) }}" class="filter-tab {% if currentStatus == 'cancelled' %}active{% endif %}">
        <i class="fa-solid fa-ban"></i> Cancelled
    </a>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2><i class="fa-solid fa-receipt" style="color:var(--gold); margin-right:8px;"></i> Orders Queue ({{ orders|length }})</h2>
    </div>

    {% if orders is empty %}
        <div style="padding: 40px; text-align: center; color: var(--muted);">
            <i class="fa-solid fa-box-open" style="font-size: 32px; margin-bottom: 12px; display: block;"></i>
            No orders found under <strong>{{ currentStatus|capitalize }}</strong> status.
        </div>
    {% else %}
    <table class="data-table">
        <thead>
            <tr>
                <th>Order Ref</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Items Ordered</th>
                <th>Payment</th>
                <th>Total</th>
                <th>Status Workflow</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for o in orders %}
            <tr>
                <td>
                    <strong style="color:var(--gold);">{{ o.order_number }}</strong>
                    <div style="font-size:11px; color:var(--muted); margin-top:2px;">{{ o.created_at|date('M d, Y h:i A') }}</div>
                </td>
                <td>
                    <strong>{{ o.customer_name }}</strong>
                    <div style="font-size:11.5px; color:var(--muted);">{{ o.customer_phone|default('No phone provided') }}</div>
                    {% if o.delivery_address %}
                        <div style="font-size:11px; color:var(--gold-light); margin-top:2px;"><i class="fa-solid fa-location-dot"></i> {{ o.delivery_address }}</div>
                    {% endif %}
                </td>
                <td>
                    {% if o.order_type == 'dinein' %}
                        <span class="badge" style="background:rgba(91,155,213,0.15);color:var(--blue);"><i class="fa-solid fa-utensils"></i> Dine In</span>
                    {% elseif o.order_type == 'takeout' %}
                        <span class="badge" style="background:rgba(201,168,76,0.15);color:var(--gold);"><i class="fa-solid fa-bag-shopping"></i> Take Out</span>
                    {% else %}
                        <span class="badge" style="background:rgba(92,184,92,0.15);color:var(--green);"><i class="fa-solid fa-motorcycle"></i> Delivery</span>
                    {% endif %}
                </td>
                <td>
                    <div style="max-width:240px; font-size:12.5px;">
                        {% for item in o.items %}
                            <div>
                                <span style="font-weight:600; color:var(--text);">{{ item.quantity }}x</span> {{ item.item_name }}
                                {% if item.addons %}
                                    <small style="color:var(--gold); font-size:10.5px;">({{ item.addons }})</small>
                                {% endif %}
                            </div>
                        {% else %}
                            <span style="color:var(--muted);">No items recorded</span>
                        {% endfor %}
                    </div>
                </td>
                <td>
                    <span style="font-size:12.5px;">{{ o.payment_method }}</span>
                </td>
                <td>
                    <strong style="color:var(--gold); font-size:15px;">₱{{ o.total_amount|number_format(2) }}</strong>
                </td>
                <td>
                    <form method="POST" action="{{ path('admin_order_status', {id: o.id}) }}" style="display:inline-block;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                        <select name="status" class="admin-select" style="font-size:11.5px; padding:4px 8px;" onchange="this.form.submit()">
                            <option value="pending" {% if o.status == 'pending' %}selected{% endif %}>Pending</option>
                            <option value="confirmed" {% if o.status == 'confirmed' %}selected{% endif %}>Confirmed</option>
                            <option value="preparing" {% if o.status == 'preparing' %}selected{% endif %}>Preparing</option>
                            <option value="ready" {% if o.status == 'ready' %}selected{% endif %}>Ready for Dispatch</option>
                            <option value="completed" {% if o.status == 'completed' %}selected{% endif %}>Completed</option>
                            <option value="cancelled" {% if o.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                        </select>
                    </form>
                </td>
                <td>
                    <form method="POST" action="{{ path('admin_order_delete', {id: o.id}) }}" onsubmit="return confirm('Remove order {{ o.order_number }}?');" style="display:inline;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="btn-danger btn-sm" title="Delete Order">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>
{% endblock %}
