{% extends 'base.html.twig' %}

{% block title %}Menu Records - Staff Portal (Symfony 6.4){% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-utensils"></i> Menu Records &amp; Dishes</h1>
        <p>View all restaurant dishes. You have full edit &amp; delete permissions on <strong>your own records</strong>. Admin and other staff records are view-only.</p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <button type="button" class="btn-primary" onclick="openAddDishModal()">
            <i class="fa-solid fa-plus"></i> Add New Dish Record
        </button>
    </div>
</div>

<div style="background:var(--surface2); border:1px solid var(--border); border-left:4px solid var(--gold); border-radius:8px; padding:12px 18px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <div style="font-size:13px; color:var(--text);">
        <i class="fa-solid fa-shield-halved" style="color:var(--gold); margin-right:8px;"></i>
        <strong>Rubric Access Rule:</strong> Staff members can create new records, and can only edit or delete records they personally created.
    </div>
    <div style="display:flex; gap:12px; font-size:11.5px;">
        <span class="badge" style="background:rgba(91,155,213,0.18); color:var(--blue); border:1px solid rgba(91,155,213,0.4);">
            <i class="fa-solid fa-circle-check"></i> Your Record (Editable)
        </span>
        <span class="badge" style="background:var(--surface3); color:var(--muted); border:1px solid var(--border);">
            <i class="fa-solid fa-lock"></i> Locked Record (View Only)
        </span>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2><i class="fa-solid fa-book-open" style="color:var(--gold); margin-right:8px;"></i> System Records Matrix ({{ inventory|length }})</h2>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Dish Details</th>
                <th>Record Ownership</th>
                <th>Category</th>
                <th>Price</th>
                <th>Current Stock</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in inventory %}
            {% set isOwner = (item.created_by == currentUserId) %}
            {% set isLow = item.stock <= item.low_stock_threshold and item.stock > 0 %}
            {% set isOut = item.stock <= 0 %}
            <tr>
                <td><small style="color:var(--muted);">#{{ item.id }}</small></td>
                <td>
                    <div style="display:flex; align-items:center; gap:12px;">
                        {% set rawImg = item.image is defined and item.image ? item.image : 'images/burger.jpg' %}
                        {% set img = rawImg starts with 'images/' ? '../../' ~ rawImg : rawImg %}
                        <img src="{{ img }}" alt="{{ item.name }}" style="width:38px; height:38px; border-radius:8px; object-fit:cover; border:1px solid var(--border);" onerror="this.onerror=null; this.src='../../images/burger.jpg';">
                        <div>
                            <strong style="color:var(--text); font-size:13.5px;">{{ item.name }}</strong>
                            {% if item.badge is defined and item.badge %}
                            <span style="display:block; font-size:10px; color:var(--gold); font-weight:600;">{{ item.badge }}</span>
                            {% endif %}
                        </div>
                    </div>
                </td>
                <td>
                    {% if isOwner %}
                        <span class="badge" style="background:rgba(91,155,213,0.18); border:1px solid rgba(91,155,213,0.4); color:var(--blue); font-weight:600;">
                            <i class="fa-solid fa-user-check"></i> Your Record (You)
                        </span>
                    {% else %}
                        <span class="badge" style="background:var(--surface2); border:1px solid var(--border); color:var(--muted);">
                            <i class="fa-solid fa-lock"></i> {{ item.creator_name|default('Administrator') }}
                        </span>
                    {% endif %}
                </td>
                <td><span class="badge" style="background:var(--surface2); color:var(--muted); text-transform:capitalize;">{{ item.category }}</span></td>
                <td><strong style="color:var(--gold);">₱{{ item.price|number_format(2) }}</strong></td>
                <td>
                    <span style="font-weight:700; color:{% if isOut or isLow %}var(--red){% else %}var(--text){% endif %};">
                        {{ item.stock }} units
                    </span>
                </td>
                <td>
                    {% if isOut %}
                    <span class="badge badge-outofstock">Out of Stock</span>
                    {% elseif isLow %}
                    <span class="badge badge-lowstock">Low Stock</span>
                    {% else %}
                    <span class="badge badge-instock">In Stock</span>
                    {% endif %}
                </td>
                <td>
                    <div style="display:flex; gap:6px; justify-content:flex-end;">
                        {% if isOwner %}
                            
                            <button type="button" class="btn-primary btn-sm"
                                onclick="openEditDishModal({{ item.id }}, '{{ item.name|e('js') }}', {{ item.price }}, '{{ item.category|e('js') }}', {{ item.stock }}, {{ item.low_stock_threshold }}, '{{ item.badge|default('')|e('js') }}', '{{ item.description|default('')|e('js') }}')">
                                <i class="fa-solid fa-pen"></i> Edit
                            </button>
                            
                            <form method="POST" action="{{ path('staff_inventory_delete', {id: item.id}) }}"
                                  onsubmit="return confirm('Are you sure you want to permanently delete your dish record: {{ item.name }}? This action cannot be undone.');" style="display:inline;">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                <button type="submit" class="btn-danger btn-sm" title="Delete Your Record">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        {% else %}
                            
                            <button type="button" class="btn-secondary btn-sm" disabled style="opacity:0.4; cursor:not-allowed;" title="Permission denied: You can only edit records you created.">
                                <i class="fa-solid fa-lock"></i> Edit
                            </button>
                            <button type="button" class="btn-secondary btn-sm" disabled style="opacity:0.4; cursor:not-allowed;" title="Permission denied: You can only delete records you created.">
                                <i class="fa-solid fa-lock"></i>
                            </button>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div id="addDishModal" class="admin-modal-backdrop">
    <div class="admin-modal-card">
        <h3 style="font-family:'Playfair Display',serif; color:var(--gold); margin-bottom:16px;">
            <i class="fa-solid fa-utensils"></i> Create New Dish Record
        </h3>
        <p style="font-size:12px; color:var(--muted); margin-bottom:16px;">
            This dish will be linked to your staff account (<strong>{{ user.name|default(user.username) }}</strong>), granting you exclusive rights to edit and manage it.
        </p>
        <form method="POST" action="{{ path('staff_inventory_add') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Dish Name *</label>
                    <input type="text" name="name" class="admin-input" style="width:100%;" required placeholder="e.g. Garlic Butter Shrimp">
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Price (₱) *</label>
                    <input type="number" step="0.01" name="price" class="admin-input" style="width:100%;" required placeholder="280.00">
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Category</label>
                    <select name="category" class="admin-select" style="width:100%;">
                        <option value="classics">Filipino Classics</option>
                        <option value="fastfood">Snacks &amp; Sides</option>
                        <option value="pasta">Pizza &amp; Pasta</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Badge (Optional)</label>
                    <input type="text" name="badge" class="admin-input" style="width:100%;" placeholder="e.g. Staff Special">
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Initial Stock Quantity</label>
                    <input type="number" name="stock" class="admin-input" style="width:100%;" value="30">
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Low Stock Alert Threshold</label>
                    <input type="number" name="threshold" class="admin-input" style="width:100%;" value="5">
                </div>
            </div>

            <div style="margin-bottom:18px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Description / Ingredients</label>
                <textarea name="description" class="admin-input" style="width:100%; height:60px;" placeholder="Fresh Gulf shrimp sautéed in garlic, butter, and lemon glaze..."></textarea>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn-secondary" onclick="closeAddDishModal()">Cancel</button>
                <button type="submit" class="btn-primary">Create Record</button>
            </div>
        </form>
    </div>
</div>

<div id="editDishModal" class="admin-modal-backdrop">
    <div class="admin-modal-card">
        <h3 style="font-family:'Playfair Display',serif; color:var(--gold); margin-bottom:16px;">
            <i class="fa-solid fa-pen"></i> Edit Your Dish Record
        </h3>
        <form id="editDishForm" method="POST" action="">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Dish Name *</label>
                    <input type="text" id="editDishName" name="name" class="admin-input" style="width:100%;" required>
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Price (₱) *</label>
                    <input type="number" step="0.01" id="editDishPrice" name="price" class="admin-input" style="width:100%;" required>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Category</label>
                    <select id="editDishCategory" name="category" class="admin-select" style="width:100%;">
                        <option value="classics">Filipino Classics</option>
                        <option value="fastfood">Snacks &amp; Sides</option>
                        <option value="pasta">Pizza &amp; Pasta</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Badge</label>
                    <input type="text" id="editDishBadge" name="badge" class="admin-input" style="width:100%;">
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Stock Quantity</label>
                    <input type="number" id="editDishStock" name="stock" class="admin-input" style="width:100%;">
                </div>
                <div>
                    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Threshold</label>
                    <input type="number" id="editDishThreshold" name="threshold" class="admin-input" style="width:100%;">
                </div>
            </div>

            <div style="margin-bottom:18px;">
                <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Description</label>
                <textarea id="editDishDesc" name="description" class="admin-input" style="width:100%; height:60px;"></textarea>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn-secondary" onclick="closeEditDishModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function openAddDishModal() {
    document.getElementById('addDishModal').classList.add('active');
}
function closeAddDishModal() {
    document.getElementById('addDishModal').classList.remove('active');
}

function openEditDishModal(id, name, price, category, stock, threshold, badge, desc) {
    const form = document.getElementById('editDishForm');
    form.action = "{{ path('staff_inventory') }}".replace('/inventory', '/inventory/edit/' + id);
    document.getElementById('editDishName').value = name;
    document.getElementById('editDishPrice').value = price;
    document.getElementById('editDishCategory').value = category;
    document.getElementById('editDishStock').value = stock;
    document.getElementById('editDishThreshold').value = threshold;
    document.getElementById('editDishBadge').value = badge || '';
    document.getElementById('editDishDesc').value = desc || '';
    document.getElementById('editDishModal').classList.add('active');
}
function closeEditDishModal() {
    document.getElementById('editDishModal').classList.remove('active');
}
</script>
{% endblock %}

