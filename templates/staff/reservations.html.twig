{% extends 'base.html.twig' %}

{% block title %}Table Reservations - Staff Portal (Symfony 6.4){% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1><i class="fa-solid fa-calendar-check"></i> Dining Reservations &amp; Seating</h1>
        <p>Coordinate table bookings and guest arrivals for Bartoces Tastes.</p>
    </div>
    <div style="display:flex; gap:10px;">
        <a href="{{ path('staff_reservations') }}?status=pending" class="btn-secondary btn-sm {% if currentStatus == 'pending' %}active{% endif %}">Pending</a>
        <a href="{{ path('staff_reservations') }}?status=confirmed" class="btn-secondary btn-sm {% if currentStatus == 'confirmed' %}active{% endif %}">Confirmed</a>
        <a href="{{ path('staff_reservations') }}?status=all" class="btn-primary btn-sm {% if currentStatus == 'all' %}active{% endif %}">All Bookings</a>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h2><i class="fa-solid fa-chair" style="color:var(--gold); margin-right:8px;"></i> Reservation Registry ({{ reservations|length }})</h2>
    </div>

    {% if reservations is empty %}
    <div style="text-align:center; padding:48px 24px; color:var(--muted);">
        <i class="fa-regular fa-calendar-xmark" style="font-size:36px; margin-bottom:12px; color:var(--surface3);"></i>
        <p>No table reservations found matching this filter.</p>
    </div>
    {% else %}
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Guest Name</th>
                <th>Date &amp; Time</th>
                <th>Party Size</th>
                <th>Seating Area</th>
                <th>Special Notes</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for r in reservations %}
            <tr>
                <td><small style="color:var(--muted);">#{{ r.id }}</small></td>
                <td>
                    <strong>{{ r.name }}</strong>
                    <div style="font-size:11.5px; color:var(--muted);"><i class="fa-solid fa-phone"></i> {{ r.phone }}</div>
                </td>
                <td>
                    <div style="font-weight:600; color:var(--text);">{{ r.reservation_date|date('M d, Y') }}</div>
                    <div style="font-size:11.5px; color:var(--gold);"><i class="fa-regular fa-clock"></i> {{ r.reservation_time }}</div>
                </td>
                <td>
                    <span class="badge" style="background:var(--surface2); color:var(--text);">
                        <i class="fa-solid fa-users"></i> {{ r.guests }}
                    </span>
                </td>
                <td>
                    <span style="font-size:12.5px; color:var(--muted);">{{ r.seating|default('Indoor Main Dining') }}</span>
                </td>
                <td>
                    <small style="color:var(--muted);">{{ r.special_notes|default('None') }}</small>
                </td>
                <td>
                    <span class="badge badge-{{ r.status }}">{{ r.status|capitalize }}</span>
                </td>
                <td>
                    <div style="display:flex; gap:6px; justify-content:flex-end;">
                        {% if r.status != 'confirmed' %}
                        <form method="POST" action="{{ path('staff_reservation_status', {id: r.id}) }}" style="display:inline;">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="status" value="confirmed">
                            <button type="submit" class="btn-success btn-sm" title="Confirm Reservation">
                                <i class="fa-solid fa-check"></i> Confirm
                            </button>
                        </form>
                        {% endif %}
                        {% if r.status != 'cancelled' %}
                        <form method="POST" action="{{ path('staff_reservation_status', {id: r.id}) }}" style="display:inline;">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="status" value="cancelled">
                            <button type="submit" class="btn-secondary btn-sm" title="Cancel Reservation">
                                <i class="fa-solid fa-ban"></i> Cancel
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>
{% endblock %}

